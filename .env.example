# ==========================================
# AI BUSINESS PROCESS RECOVERY AGENT CONFIG
# ==========================================

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Database Configuration (SQLite default; PostgreSQL ready)
DATABASE_URL=sqlite:///./recovery_agent.db

# LLM Provider Configuration
# Supported: "heuristic" (default built-in deterministic fallback, no key needed), "openai", "gemini", "anthropic"
LLM_PROVIDER=heuristic
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Autonomous Recovery Agent Settings
AUTO_RECOVERY_ENABLED=True
MAX_RECOVERY_RETRIES=3
APPROVAL_SEVERITY_THRESHOLD=MEDIUM
# Approvals required for actions matching: ["replace_product", "cancel_order", "refund_payment", "change_price"]
REQUIRE_APPROVAL_FOR_REPLACEMENTS=True

# Chaos & Failure Simulation Defaults
CHAOS_MODE_ENABLED=False
